# document-parser systemd 服务单元模板
#
# 用法（二选一）：
#   1. 手动：把下面 __占位符__ 替换后复制到 /etc/systemd/system/document-parser.service
#   2. 自动：直接跑 scripts/install.sh（会替换占位符并安装）
#
# 关键字段说明见 ../SYSTEMD_SETUP_GUIDE.md 第 2.2 节

[Unit]
Description=Document Parser Service (MCP document-parser)
After=network.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.document-parser.env
ExecStart=__INSTALL_DIR__/document-parser server
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=document-parser

# GPU 场景：如运行用户访问 /dev/nvidia* 受限，取消下面注释并把用户加入对应组
# SupplementaryGroups=video render

[Install]
WantedBy=multi-user.target
