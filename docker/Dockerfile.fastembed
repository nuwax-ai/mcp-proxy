# syntax=docker/dockerfile:1
# 多阶段构建 Dockerfile，用于编译 fastembed (文本嵌入 HTTP 服务)
#
# fastembed 已是 workspace 成员（不在 default-members，因 ort-sys 编译期需联网
# 下载预编译 ONNX 库且编译耗时）。容器内用 -p fastembed-server 显式编译即可，
# default-members 不影响 -p 指定。
# package 名为 fastembed-server，bin/命令名保持 fastembed。
#
# 用法:
#   make build-fastembed-x86_64
FROM rust:1.92 AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    openssl \
    ca-certificates \
    build-essential \
    libc6-dev \
    gcc \
    g++ \
    libclang-dev \
    clang \
    cmake \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN rustup component add rustfmt
COPY . .

# 编译（-p fastembed-server 指定 package；--bin fastembed 因不在 default-members 而无法解析）
RUN --mount=type=cache,target=/app/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    export LIBCLANG_PATH=$(find /usr -name "libclang.so*" -printf "%h\n" 2>/dev/null | sort -u | head -1) && \
    echo "LIBCLANG_PATH=$LIBCLANG_PATH" && \
    cargo build --release -p fastembed-server && \
    mkdir -p /output && cp target/release/fastembed /output/

FROM scratch AS runtime
COPY --from=builder /output/fastembed /fastembed
ENTRYPOINT ["/fastembed"]

FROM scratch AS export
COPY --from=builder /output/fastembed /fastembed
