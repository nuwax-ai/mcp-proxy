# test-e2e 目标服务地址示例（复制为 .env.local 使用；.env.local 已 gitignore）
# 环境变量优先级高于本文件；都不配置时默认本机 127.0.0.1

# document-parser 服务基址
E2E_DOCUMENT_PARSER_URL=http://192.168.32.131:8087

# voice-cli 服务基址
E2E_VOICE_CLI_URL=http://192.168.32.131:8077

# 转写用 whisper 模型（按目标机器实际安装选：base / large-v3 / …）
E2E_VOICE_MODEL=base

# uploadFromUrl 场景的公网文件 URL（nuwax-upload 上传产物；不配置则该场景 SKIP）
# E2E_ASSET_URL=https://s3.nuwax.com:9443/nuwax-packages/docker/<ts>/verify.pdf

# TTS 全链路断言（默认 0：只验协议行为；=1 且模型已装时断言 ready）
E2E_TTS=0
