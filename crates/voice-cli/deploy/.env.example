# voice-cli 环境变量（可选，覆盖 config.yml 的值）
# 用 systemd 时 export 这些变量（写到 Environment= / EnvironmentFile=，见 voice-cli.service）

# 日志级别（trace/debug/info/warn/error）
RUST_LOG=info

# 以下用 config-rs 的环境变量覆盖机制：前缀 VOICE_CLI + 段名（双下划线分隔嵌套）
# 一般不用设，改 config.yml 即可。仅列出来供参考：
# VOICE_CLI_SERVER__PORT=8077                  # 覆盖 server.port
# VOICE_CLI_SERVER__HOST=0.0.0.0
# VOICE_CLI_WHISPER__DEFAULT_MODEL=large-v3
# VOICE_CLI_LOGGING__LEVEL=debug
